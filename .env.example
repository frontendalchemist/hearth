# Copy this file to apps/web/.env.local and fill in values.
# Never commit .env.local — it is gitignored.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon pooled connection string (get from Neon dashboard → Connection Details)
DATABASE_URL=

# ─── Redis ───────────────────────────────────────────────────────────────────
# Upstash REST API (get from Upstash dashboard → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# Generate AUTH0_SECRET with: openssl rand -hex 32 (64 hex chars)
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=hearth.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ─── AWS / S3 ────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=hearth-documents-dev

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
# Resend (Stage 1) — get from resend.com dashboard
RESEND_API_KEY=

# ─── Analytics ───────────────────────────────────────────────────────────────
# PostHog — public key is safe to expose in the browser. Browser SDK is
# reverse-proxied through /ingest (see apps/web/next.config.mjs) so the
# PostHog host is not exposed to the client and is not configurable via env.
NEXT_PUBLIC_POSTHOG_KEY=

# ─── Cron security ───────────────────────────────────────────────────────────
# Vercel passes this header automatically to cron Route Handlers
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Error tracking ──────────────────────────────────────────────────────────
# Public DSN — safe to expose in the browser. When unset, the SDK no-ops
# silently, so dev without a Sentry account still works.
NEXT_PUBLIC_SENTRY_DSN=
# Auth token + org + project enable source-map upload at build time. Set
# in CI / Netlify deploy env only — these are not browser-safe.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
