{
  "name": "hearth",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:unit:watch": "pnpm --filter @hearth/web test:unit:watch",
    "test:e2e": "turbo test:e2e",
    "test:integration": "turbo test:integration",
    "playwright:install": "pnpm --filter @hearth/web exec playwright install chromium",
    "storybook": "pnpm --filter @hearth/web storybook",
    "build-storybook": "pnpm --filter @hearth/web build-storybook",
    "chromatic": "pnpm --filter @hearth/web chromatic",
    "a11y-audit": "pnpm --filter @hearth/web a11y-audit",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "db:reset": "pnpm --filter @hearth/db db:reset",
    "db:studio": "pnpm --filter @hearth/db db:studio",
    "db:cleanup-test-branches": "pnpm --filter @hearth/web db:cleanup-test-branches",
    "graphql:codegen": "pnpm --filter @hearth/web graphql:codegen",
    "lighthouse": "pnpm --filter @hearth/web lighthouse",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@netlify/functions": "^5.2.0",
    "prettier": "^3.3.0",
    "turbo": "^2.9.14",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
